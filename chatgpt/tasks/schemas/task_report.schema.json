{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task_report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_id", "task_revision", "task_sha256", "status", "branch", "base_commit", "changed_files", "requirements", "tests", "heavy_validation", "commit", "push", "notes"],
  "properties": {
    "schema_version": {"const": 1.0}, "work_id": {"type": "string"}, "task_revision": {"type": "integer", "minimum": 1}, "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "status": {"enum": ["done", "partial", "blocked", "failed"]}, "branch": {"type": "string"}, "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "changed_files": {"type": "array", "items": {"type": "string"}},
    "requirements": {"type": "object", "additionalProperties": {"$ref": "#/$defs/evidence"}}, "tests": {"type": "array", "items": {"$ref": "#/$defs/evidence_with_command"}}, "heavy_validation": {"$ref": "#/$defs/heavy"}, "commit": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/commit"}]}, "push": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/push"}]}, "notes": {"type": "string"}
  },
  "$defs": {
    "evidence": {"type": "object", "additionalProperties": false, "required": ["status", "evidence"], "properties": {"status": {"enum": ["pass", "fail", "not_run"]}, "evidence": {"type": "string"}}},
    "evidence_with_command": {"type": "object", "additionalProperties": false, "required": ["command", "status", "evidence"], "properties": {"command": {"type": "string"}, "status": {"enum": ["pass", "fail", "not_run"]}, "evidence": {"type": "string"}}},
    "heavy": {"type": "object", "additionalProperties": false, "required": ["authorized", "planned_work_units", "full_runs", "commands"], "properties": {"authorized": {"type": "boolean"}, "planned_work_units": {"type": "integer", "minimum": 0}, "full_runs": {"type": "integer", "minimum": 0}, "commands": {"type": "array", "items": {"$ref": "#/$defs/evidence_with_command"}}}},
    "commit": {"type": "object", "additionalProperties": false, "required": ["hash", "message"], "properties": {"hash": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "message": {"type": "string"}}},
    "push": {"type": "object", "additionalProperties": false, "required": ["remote", "branch", "commit"], "properties": {"remote": {"type": "string"}, "branch": {"type": "string"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}
  }
}
