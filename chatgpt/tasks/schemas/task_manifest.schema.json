{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task_manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_id", "revision", "stage", "mode", "goal", "repo", "contract_refs", "allowed", "autonomy", "requirements", "validation", "commit", "stop_codes", "report"],
  "properties": {
    "schema_version": {"const": 1.0},
    "work_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "stage": {"enum": ["implementation", "acceptance", "review", "checkpoint", "runtime"]},
    "mode": {"enum": ["BOUNDED_CODEX", "REVIEW_ONLY", "CHECKPOINT_PUSH", "RUNTIME_TASK"]},
    "goal": {"type": "string", "minLength": 1},
    "repo": {"$ref": "#/$defs/repo"},
    "contract_refs": {"$ref": "#/$defs/paths"},
    "allowed": {"type": "object", "additionalProperties": false, "required": ["read", "edit", "diff_check"], "properties": {"read": {"$ref": "#/$defs/paths"}, "edit": {"$ref": "#/$defs/paths"}, "diff_check": {"$ref": "#/$defs/paths"}}},
    "autonomy": {"type": "object", "additionalProperties": false, "properties": {"edit_helpers": {"type": "boolean"}, "add_fixtures": {"type": "boolean"}, "add_regressions": {"type": "boolean"}, "remove_duplicate_calculations": {"type": "boolean"}, "add_semantics_preserving_cache": {"type": "boolean"}, "choose_bounded_order": {"type": "boolean"}}},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "description"], "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}}},
    "validation": {"$ref": "#/$defs/validation"},
    "commit": {"type": "object", "additionalProperties": false, "required": ["enabled", "message"], "properties": {"enabled": {"type": "boolean"}, "message": {"type": "string", "minLength": 1}}},
    "stop_codes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "report": {"type": "object", "additionalProperties": false, "required": ["format", "outbox", "write_once"], "properties": {"format": {"const": "json_v1"}, "outbox": {"const": "/Users/marupro/CODEX/chatGPTweb-to-Terminal/outbox/response.txt"}, "write_once": {"const": true}}}
  },
  "$defs": {
    "paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "repo": {"type": "object", "additionalProperties": false, "required": ["expected_branch", "expected_base_commit", "working_dir", "frozen_runtime_repo"], "properties": {"expected_branch": {"type": "string", "minLength": 1}, "expected_base_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}, "working_dir": {"type": "string"}, "frozen_runtime_repo": {"type": ["string", "null"]}}},
    "validation": {"type": "object", "additionalProperties": false, "required": ["unit_tests", "heavy"], "properties": {"unit_tests": {"type": "array", "items": {"type": "string", "minLength": 1}}, "heavy": {"type": "object", "additionalProperties": false, "required": ["authorized", "planned_work_units", "max_full_runs", "commands"], "properties": {"authorized": {"type": "boolean"}, "planned_work_units": {"type": "integer", "minimum": 0}, "max_full_runs": {"type": "integer", "minimum": 0}, "commands": {"type": "array", "items": {"type": "string", "minLength": 1}}}}}}
  }
}
