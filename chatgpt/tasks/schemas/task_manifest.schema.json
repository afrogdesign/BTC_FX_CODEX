{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task_manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_id", "revision", "stage", "mode", "goal", "repo", "contract_refs", "allowed", "autonomy", "requirements", "validation", "commit", "stop_codes", "report"],
  "allOf": [{"if": {"properties": {"stage": {"const": "acceptance"}}}, "then": {"properties": {"repo": {"properties": {"expected_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}}}}],
  "properties": {
    "schema_version": {"const": "1.0"}, "work_id": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1},
    "stage": {"enum": ["implementation", "acceptance", "review", "checkpoint", "runtime"]}, "mode": {"enum": ["BOUNDED_CODEX", "REVIEW_ONLY", "CHECKPOINT_PUSH", "RUNTIME_TASK"]}, "goal": {"type": "string", "minLength": 1},
    "repo": {"$ref": "#/$defs/repo"}, "contract_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contract_ref"}},
    "allowed": {"type": "object", "additionalProperties": false, "required": ["read", "edit", "inspect"], "properties": {"read": {"$ref": "#/$defs/paths"}, "edit": {"$ref": "#/$defs/paths"}, "inspect": {"type": "array", "items": {"enum": ["git_status", "task_diff", "target_definition", "direct_callers", "nearby_helpers", "matching_tests"]}}}},
    "autonomy": {"$ref": "#/$defs/autonomy"}, "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}}, "validation": {"$ref": "#/$defs/validation"},
    "commit": {"$ref": "#/$defs/commit"}, "stop_codes": {"type": "array", "items": {"type": "string", "minLength": 1}}, "report": {"$ref": "#/$defs/report"}
  },
  "$defs": {
    "paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "repo": {"type": "object", "additionalProperties": false, "required": ["working_dir", "expected_branch", "expected_base_commit"], "properties": {"working_dir": {"type": "string"}, "expected_branch": {"type": "string", "minLength": 1}, "expected_base_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}}},
    "contract_ref": {"type": "object", "additionalProperties": false, "required": ["path", "clauses"], "properties": {"path": {"type": "string", "minLength": 1}, "clauses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "autonomy": {"type": "object", "additionalProperties": false, "properties": {"helper_design": {"type": "boolean"}, "cache_design": {"type": "boolean"}, "fixture_design": {"type": "boolean"}, "execution_order": {"type": "boolean"}, "obvious_in_scope_bugfix": {"type": "boolean"}, "remove_redundant_validation": {"type": "boolean"}}},
    "requirement": {"type": "object", "additionalProperties": false, "required": ["id", "description"], "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}},
    "validation": {"type": "object", "additionalProperties": false, "required": ["unit_tests", "fixture_e2e", "diff_check_files", "heavy"], "properties": {"unit_tests": {"type": "array", "items": {"type": "string", "minLength": 1}}, "fixture_e2e": {"type": "object", "additionalProperties": false, "required": ["required", "location"], "properties": {"required": {"type": "boolean"}, "location": {"type": ["string", "null"]}}}, "diff_check_files": {"$ref": "#/$defs/paths"}, "heavy": {"type": "object", "additionalProperties": false, "required": ["authorized", "planned_work_units", "max_full_runs", "commands"], "properties": {"authorized": {"type": "boolean"}, "planned_work_units": {"type": "integer", "minimum": 0}, "max_full_runs": {"type": "integer", "minimum": 0}, "commands": {"type": "array", "items": {"type": "string", "minLength": 1}}}}}},
    "commit": {"type": "object", "additionalProperties": false, "required": ["enabled", "message", "push"], "properties": {"enabled": {"type": "boolean"}, "message": {"type": "string", "minLength": 1}, "push": {"type": "boolean"}}},
    "report": {"type": "object", "additionalProperties": false, "required": ["format", "outbox", "write_once"], "properties": {"format": {"const": "json_v1"}, "outbox": {"const": "/Users/marupro/CODEX/chatGPTweb-to-Terminal/outbox/response.txt"}, "write_once": {"const": true}}}
  }
}
